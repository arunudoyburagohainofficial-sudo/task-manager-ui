# Google Sign-In — Web-type OAuth client ID (not a secret; safe to commit — see
# https://developers.google.com/identity/protocols/oauth2#OOB for why public/native
# client IDs aren't confidential). Auto-created by Firebase when Google was enabled as a
# sign-in provider on taskmanager-704f5; found under Google Cloud Console → APIs &
# Services → Credentials → OAuth 2.0 Client IDs → "Web client (auto created by Google Service)".
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=1094191642804-7ambtt3b59daqmg87ftulblh6f4mt6k2.apps.googleusercontent.com

# Google Sign-In — Android-type OAuth client ID (also not a secret — Android/iOS client
# types don't even have a secret, verified via package name + signing certificate SHA-1
# instead). Registered against com.mactora.taskManager + the EAS-managed keystore's
# SHA-1 fingerprint, in Google Cloud Console → APIs & Services → Credentials.
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=1094191642804-1r0gicark3ah8mda617a0fgif5nbplp5.apps.googleusercontent.com
