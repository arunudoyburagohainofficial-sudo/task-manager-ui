.env*.local

# typescript
*.tsbuildinfo

# generated native folders
/ios
/android

# Gradle output inside local Expo modules. The /android rule above is anchored to the repo
# root, so it doesn't reach modules/*/android — without this, `git add modules/` stages ~137
# build artifacts (jars, classes, resource maps) alongside the 10 files that are actually source.
modules/*/android/build/
modules/*/android/.gradle/
modules/*/android/local.properties

.idea
designdocs

# google-services.json / GoogleService-Info.plist are deliberately tracked, not
# ignored — they're client-side Firebase config (project ID + a domain-restricted API
# key), not secrets, and EAS Build's project archive is built from what git tracks. An
# ignored copy here is invisible to EAS regardless of being present on disk locally,
# so a cloud build would silently produce an app Firebase can't initialize in.


task-app/design_handoff_focus_capture_app
task-app/design_handoff_focus_capture_app 2

handoffs
# Playwright output
/test-results/
/playwright-report/
/e2e/

# Junk from a script that resolved its output path to the literal string "undefined".
/undefined/
